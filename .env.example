# Frontend
VITE_API_URL=http://localhost:8000

# API access
CORS_ORIGINS=http://localhost:5173

# Optional LLM provider configuration
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SAP ECC RFC (leave disabled unless credentials are configured)
SAP_ECC_ENABLED=false
SAP_ECC_ASHOST=
SAP_ECC_SYSNR=
SAP_ECC_CLIENT=
SAP_ECC_USER=
SAP_ECC_PASSWD=
SAP_ECC_LANG=EN

# SAP S/4HANA OData (leave disabled unless credentials are configured)
SAP_ODATA_ENABLED=false
SAP_ODATA_BASE_URL=
SAP_ODATA_USER=
SAP_ODATA_PASSWD=

# Local infrastructure
DATABASE_URL=postgresql+asyncpg://primecon:primecon_secret@localhost:5432/primecon
REDIS_URL=redis://localhost:6379/0
